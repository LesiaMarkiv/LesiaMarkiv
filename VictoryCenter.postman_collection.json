        {
          "name": "200 Partners section",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const responseJson = pm.response.json();",
                  "",
                  "    pm.test(\"Response has a top-level id\", function () {",
                  "        pm.expect(responseJson).to.be.an(\"object\");",
                  "        pm.expect(responseJson).to.have.property(\"id\");",
                  "    });",
                  "",
                  "    if (responseJson && Object.prototype.hasOwnProperty.call(responseJson, \"id\")) {",
                  "        pm.environment.set(\"sectionID\", responseJson.id);",
                  "    }",
                  "",
                  "    pm.test(\"Response has partners array with at least one partner\", function () {",
                  "        pm.expect(responseJson).to.have.property(\"partners\");",
                  "        pm.expect(responseJson.partners).to.be.an(\"array\").that.is.not.empty;",
                  "        pm.expect(responseJson.partners[0]).to.have.property(\"id\");",
                  "    });",
                  "",
                  "    if (responseJson.partners && responseJson.partners.length > 0 && Object.prototype.hasOwnProperty.call(responseJson.partners[0], \"id\")) {",
                  "        pm.environment.set(\"partnerID\", responseJson.partners[0].id);",
                  "    }",
                  "}",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
